\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Experiments. Reference settings are in bold and every other setting is at its value in Table~\ref {tab:params}. Factors move one at a time from the reference unless crossed ($\times $), and every run lasts 40 quarters. The three priority rules differ by at most 0.003 in mean displacement, every paired interval includes zero, and every strategy keeps the lottery.}}{8}{table.caption.23}\protected@file@percent }
\newlabel{tab:levels}{{4}{8}{Experiments. Reference settings are in bold and every other setting is at its value in Table~\ref {tab:params}. Factors move one at a time from the reference unless crossed ($\times $), and every run lasts 40 quarters. The three priority rules differ by at most 0.003 in mean displacement, every paired interval includes zero, and every strategy keeps the lottery}{table.caption.23}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Calibration patterns, with the calibrated baseline over 50 seeds (values with the affordability screen off come from the ten-seed screening check). \texttt  {access-lost} counts the unhoused as having no access, so ever-displaced households still unhoused at quarter 40 add to the P4 gap mechanically. The pilot failures pointed to the processes added. P2 needed moves unrelated to stress, and P3 higher-income renters holding high- and medium-tier vacancies, extending the competition for low-rent stock in \citep  {2}. For P4 we put two candidates behind switches, landlord screening \citep  {31} and an affordability screen on new tenancies \citep  {13}.}}{9}{table.caption.24}\protected@file@percent }
\newlabel{tab:patterns}{{5}{9}{Calibration patterns, with the calibrated baseline over 50 seeds (values with the affordability screen off come from the ten-seed screening check). \texttt {access-lost} counts the unhoused as having no access, so ever-displaced households still unhoused at quarter 40 add to the P4 gap mechanically. The pilot failures pointed to the processes added. P2 needed moves unrelated to stress, and P3 higher-income renters holding high- and medium-tier vacancies, extending the competition for low-rent stock in \citep {2}. For P4 we put two candidates behind switches, landlord screening \citep {31} and an affordability screen on new tenancies \citep {13}}{table.caption.24}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Calibration with \texttt  {strategy} none on pilot-v4, 12 sets (\texttt  {bg-target-move-prob} 0.10, 0.12, 0.15; \texttt  {termination-hazard-base} 0.006, 0.0075; \texttt  {non-target-frac-mid} 0.15, 0.20), ten seeds each. (a) \texttt  {stress-prevalence} over quarters 1 to 4 and at quarter 40, and displacements per household, with the first-year target and the $E$ band shaded. (b) \texttt  {forced-move-share}. (c) Rent Increase by Tier (rent over initial rent, pens high, medium, low) against \texttt  {non-target-frac-mid}. (d) \texttt  {access-lost-displaced} against \texttt  {access-lost-not-displaced} with \texttt  {max-rent-to-income} 1 (screen off) and 0.5, from the screening check at the calibrated set, ten seeds.}}{10}{figure.caption.26}\protected@file@percent }
\newlabel{fig:calib}{{2}{10}{Calibration with \texttt {strategy} none on pilot-v4, 12 sets (\texttt {bg-target-move-prob} 0.10, 0.12, 0.15; \texttt {termination-hazard-base} 0.006, 0.0075; \texttt {non-target-frac-mid} 0.15, 0.20), ten seeds each. (a) \texttt {stress-prevalence} over quarters 1 to 4 and at quarter 40, and displacements per household, with the first-year target and the $E$ band shaded. (b) \texttt {forced-move-share}. (c) Rent Increase by Tier (rent over initial rent, pens high, medium, low) against \texttt {non-target-frac-mid}. (d) \texttt {access-lost-displaced} against \texttt {access-lost-not-displaced} with \texttt {max-rent-to-income} 1 (screen off) and 0.5, from the screening check at the calibrated set, ten seeds}{figure.caption.26}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Stage 1. Displacements per household at quarter 40 by \texttt  {govt-homes} (a) and \texttt  {govt-homes-build-time} (b), one box per \texttt  {strategy} and level. 50 paired runs per cell. Displacement falls from 0.25 to 0.26 at 5 per cent supply to 0.12 to 0.13 at 30. Under each \texttt  {priority-rule} (not shown), concentrated is lowest, and the rules differ by at most 0.003, every paired interval including zero.}}{11}{figure.caption.27}\protected@file@percent }
\newlabel{fig:levels}{{3}{11}{Stage 1. Displacements per household at quarter 40 by \texttt {govt-homes} (a) and \texttt {govt-homes-build-time} (b), one box per \texttt {strategy} and level. 50 paired runs per cell. Displacement falls from 0.25 to 0.26 at 5 per cent supply to 0.12 to 0.13 at 30. Under each \texttt {priority-rule} (not shown), concentrated is lowest, and the rules differ by at most 0.003, every paired interval including zero}{figure.caption.27}{}}
\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces The window and induced-demand diagnostics at quarter 40, means with ranges over strategies. The model does not record how many tenants of new units would otherwise have been displaced. Under concentration induced demand changes who gets the new units but not displacement, and the affordability screen does not block movers.}}{11}{table.caption.28}\protected@file@percent }
\newlabel{tab:diag}{{6}{11}{The window and induced-demand diagnostics at quarter 40, means with ranges over strategies. The model does not record how many tenants of new units would otherwise have been displaced. Under concentration induced demand changes who gets the new units but not displacement, and the affordability screen does not block movers}{table.caption.28}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces The theory test. \texttt  {displaced-share} (a) and \texttt  {stress-prevalence} (b) at quarter 40 by \texttt  {strategy} under \texttt  {search-rule} random, cheapest and utility, mean and standard deviation over ten seeds. With \texttt  {strategy} none, displacement is 0.283 under random and 0.279 under utility, and under cheapest, concentrated reaches 0.258 against 0.241 for dispersed and 0.244 for demand-proportional.}}{12}{figure.caption.29}\protected@file@percent }
\newlabel{fig:theory}{{4}{12}{The theory test. \texttt {displaced-share} (a) and \texttt {stress-prevalence} (b) at quarter 40 by \texttt {strategy} under \texttt {search-rule} random, cheapest and utility, mean and standard deviation over ten seeds. With \texttt {strategy} none, displacement is 0.283 under random and 0.279 under utility, and under cheapest, concentrated reaches 0.258 against 0.241 for dispersed and 0.244 for demand-proportional}{figure.caption.29}{}}
\@writefile{lot}{\contentsline {table}{\numberline {7}{\ignorespaces Stage 2 at quarter 40, 10 per cent supply, 50 paired seeds. $E$ is displacements per household. $\Delta E$ is the within-seed paired reduction against the baseline, with a 95 per cent bootstrap interval over seeds. \texttt  {access-lost} is a mean, and aff.\ tenants stressed (\texttt  {affordable-stressed-share}) is the share of tenants in new units above the stress line. $\Delta E$ is paired per seed before rounding, so it can differ from the difference of the rounded means. The lowest-income third has the highest share ever displaced under every strategy and the largest reduction in it, 0.048 to 0.062 against 0.036 to 0.052 for the other thirds.}}{12}{table.caption.31}\protected@file@percent }
\newlabel{tab:stage2}{{7}{12}{Stage 2 at quarter 40, 10 per cent supply, 50 paired seeds. $E$ is displacements per household. $\Delta E$ is the within-seed paired reduction against the baseline, with a 95 per cent bootstrap interval over seeds. \texttt {access-lost} is a mean, and aff.\ tenants stressed (\texttt {affordable-stressed-share}) is the share of tenants in new units above the stress line. $\Delta E$ is paired per seed before rounding, so it can differ from the difference of the rounded means. The lowest-income third has the highest share ever displaced under every strategy and the largest reduction in it, 0.048 to 0.062 against 0.036 to 0.052 for the other thirds}{table.caption.31}{}}
\@writefile{lot}{\contentsline {table}{\numberline {8}{\ignorespaces Local sensitivity $\bar  S$ of the key metric to each parameter under each condition, the mean relative change in $E$ per unit relative change in the parameter, 30 seeds. Continuous parameters move $\pm 15$ per cent. The number of neighbourhoods sampled $k$ moves 3, 4, 5 and the search period $s$ moves 1, 2, 3 quarters, each divided by its own relative shift. Rows give the model's variable name, then the report's symbol. Households are shifted with stock so that occupancy is held fixed. Values of 0.20 or more are in bold, and supply, its cost, and the affordable rent ratio do not apply to the baseline. $b_{\mathrm  {high}}$ and $c_{\mathrm  {high}}$ are $b_j$ and $c_j$ of the high tier.}}{13}{table.caption.33}\protected@file@percent }
\newlabel{tab:sens}{{8}{13}{Local sensitivity $\bar S$ of the key metric to each parameter under each condition, the mean relative change in $E$ per unit relative change in the parameter, 30 seeds. Continuous parameters move $\pm 15$ per cent. The number of neighbourhoods sampled $k$ moves 3, 4, 5 and the search period $s$ moves 1, 2, 3 quarters, each divided by its own relative shift. Rows give the model's variable name, then the report's symbol. Households are shifted with stock so that occupancy is held fixed. Values of 0.20 or more are in bold, and supply, its cost, and the affordable rent ratio do not apply to the baseline. $b_{\mathrm {high}}$ and $c_{\mathrm {high}}$ are $b_j$ and $c_j$ of the high tier}{table.caption.33}{}}
\@writefile{lot}{\contentsline {table}{\numberline {9}{\ignorespaces Robustness of the stage 2 result at 10 per cent supply. The lead is the smaller of concentration's two mean within-seed paired advantages over its rivals, with a 95 per cent bootstrap interval, and the last column is the range of reductions in $E$ by the three strategies. Without background demand or higher-income renters \texttt  {rent-increase-high} rises 14 per cent rather than 55. Path lengths are means over 30 random shortcut layouts, and when displaced households leave none can be displaced twice.}}{13}{table.caption.35}\protected@file@percent }
\newlabel{tab:robust}{{9}{13}{Robustness of the stage 2 result at 10 per cent supply. The lead is the smaller of concentration's two mean within-seed paired advantages over its rivals, with a 95 per cent bootstrap interval, and the last column is the range of reductions in $E$ by the three strategies. Without background demand or higher-income renters \texttt {rent-increase-high} rises 14 per cent rather than 55. Path lengths are means over 30 random shortcut layouts, and when displaced households leave none can be displaced twice}{table.caption.35}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Stage 2. \texttt  {strategy} none against the three strategies with the lottery and \texttt  {govt-homes} 10, 50 paired runs. (a) Displacements per household by quarter (the model's plot ``Displacement and stress''), median and interquartile band. (b) \texttt  {displaced-share} at quarter 40, with the \texttt  {mean-field?} true value as a diamond, whose gain is 0.046 to 0.047 for every strategy. In this version concentration's lead is $-0.004$, 0.001, 0.002, 0.004, and 0.004 at 5, 10, 15, 20, and 30 per cent supply. (c) \texttt  {stress-share-nb} by neighbourhood id, with ids 7 to 12 the high tier. Under the baseline 0.99 to 1.00 of households are stressed in each of the 14 high and medium neighbourhoods. (d) \texttt  {displaced-share} by \texttt  {govt-homes}.}}{14}{figure.caption.30}\protected@file@percent }
\newlabel{fig:pooled}{{5}{14}{Stage 2. \texttt {strategy} none against the three strategies with the lottery and \texttt {govt-homes} 10, 50 paired runs. (a) Displacements per household by quarter (the model's plot ``Displacement and stress''), median and interquartile band. (b) \texttt {displaced-share} at quarter 40, with the \texttt {mean-field?} true value as a diamond, whose gain is 0.046 to 0.047 for every strategy. In this version concentration's lead is $-0.004$, 0.001, 0.002, 0.004, and 0.004 at 5, 10, 15, 20, and 30 per cent supply. (c) \texttt {stress-share-nb} by neighbourhood id, with ids 7 to 12 the high tier. Under the baseline 0.99 to 1.00 of households are stressed in each of the 14 high and medium neighbourhoods. (d) \texttt {displaced-share} by \texttt {govt-homes}}{figure.caption.30}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Stage 3, 50 paired runs, differences from the case with every switch true with 95 per cent bootstrap intervals. (a) \texttt  {displaced-share} with \texttt  {induced-demand?} false, \texttt  {rent-feedback?} false, and both false. With both off concentration's lead is 0.004 (advantages 0.004 and 0.006), intervals excluding zero. Without security, removing the discount raises displacement by 0.003 to 0.009. Against their own baseline, the strategies gain 0.036 to 0.041 with rent feedback off. (b) \texttt  {displaced-share} and (c) mean stress quarters (\texttt  {mean-stress-duration}) with \texttt  {secure-tenure?} false and with \texttt  {rent-discount?} false, which adds 0.7 to 1.5 quarters of stress. Removing the discount lowers displacement by 0.0075 under dispersal and by at most 0.002 otherwise.}}{14}{figure.caption.32}\protected@file@percent }
\newlabel{fig:mechanism}{{6}{14}{Stage 3, 50 paired runs, differences from the case with every switch true with 95 per cent bootstrap intervals. (a) \texttt {displaced-share} with \texttt {induced-demand?} false, \texttt {rent-feedback?} false, and both false. With both off concentration's lead is 0.004 (advantages 0.004 and 0.006), intervals excluding zero. Without security, removing the discount raises displacement by 0.003 to 0.009. Against their own baseline, the strategies gain 0.036 to 0.041 with rent feedback off. (b) \texttt {displaced-share} and (c) mean stress quarters (\texttt {mean-stress-duration}) with \texttt {secure-tenure?} false and with \texttt {rent-discount?} false, which adds 0.7 to 1.5 quarters of stress. Removing the discount lowers displacement by 0.0075 under dispersal and by at most 0.002 otherwise}{figure.caption.32}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces How the \texttt  {strategy} ranking holds up against the most sensitive parameter, \texttt  {termination-hazard-base} ($h_0$), at its low, reference, and high value. Displacements per household at quarter 40, 30 seeds.}}{15}{figure.caption.34}\protected@file@percent }
\newlabel{fig:ranking}{{7}{15}{How the \texttt {strategy} ranking holds up against the most sensitive parameter, \texttt {termination-hazard-base} ($h_0$), at its low, reference, and high value. Displacements per household at quarter 40, 30 seeds}{figure.caption.34}{}}
