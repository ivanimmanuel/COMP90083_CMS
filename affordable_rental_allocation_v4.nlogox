          <value value="26"></value>
          <value value="27"></value>
          <value value="28"></value>
          <value value="29"></value>
          <value value="30"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="strategy">
          <value value="&quot;concentrated&quot;"></value>
          <value value="&quot;dispersed&quot;"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="induced-demand?">
          <value value="true"></value>
          <value value="false"></value>
        </enumeratedValueSet>
