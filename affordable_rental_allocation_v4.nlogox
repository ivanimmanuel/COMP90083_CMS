  <experiments>
    <experiment name="induced-demand-diagnostic" repetitions="1" sequentialRunOrder="false" runMetricsEveryStep="false" timeLimit="40">
      <setup>setup</setup>
      <go>go</go>
      <metrics>
        <metric>displaced-share</metric>
        <metric>affordable-occupancy</metric>
        <metric><![CDATA[count turtles with [affordable-rent-ratio * mean [market-rent] of all-neighbourhoods with [tier = 2] <= max-rent-to-income * income] / count turtles]]></metric>
        <metric><![CDATA[count turtles with [tenure = "unhoused" and affordable-rent-ratio * mean [market-rent] of all-neighbourhoods with [tier = 2] <= max-rent-to-income * income] / max list 1 count turtles with [tenure = "unhoused"]]]></metric>
        <metric><![CDATA[count turtles with [tenure = "affordable" and init-access < 1] / max list 1 count turtles with [tenure = "affordable"]]]></metric>
        <metric>count turtles with [tenure = "affordable" and ever-displaced?] / max list 1 count turtles with [tenure = "affordable"]</metric>
      </metrics>
      <constants>
        <enumeratedValueSet variable="seed">
          <value value="1"></value>
          <value value="2"></value>
          <value value="3"></value>
          <value value="4"></value>
          <value value="5"></value>
