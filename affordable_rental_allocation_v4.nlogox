<?xml version="1.0" encoding="utf-8"?>
<model version="NetLogo 7.0.4" snapToGrid="false">
  <code><![CDATA[;; =====================================================================
;; COMP90083 Project 2 (2026)
;; Spatial allocation of affordable rental supply and displacement
;; Agent-based model of lower-income renter households in a stylised
;; Melbourne-like region of 20 neighbourhoods on a ring.
;;
;; Ivan Ramos Sampe Immanuel and Fella Ulandari
;;
;; Version 2 (17 September 2026). Adds the stage 3 unit-protection switches:
;;   secure-tenure?   affordable tenancies are exempt from the termination
;;                    hazard (on) or face the same hazard as market ones (off)
;;   rent-discount?   affordable rent is affordable-rent-ratio x market rent (on) or
;;                    equal to market rent (off): secure but not cheaper
;;   affordable-rent-rule    "market-share" (lambda x market rent) or "income-share"
;;                    (income-rent-share x household income, the social-housing rule)
;; plus per-neighbourhood stress reporters for the ring heat map and
;; aff-stressed-share, the share of affordable tenants still in stress.

;; Version 2.1 adds the policy-maker's view and two saturation guards:
;;   fixed-budget?    the same spending buys fewer dwellings where the cost
;;                    index is higher (cost-high/mid/low, medium tier = 1)
;;   income-growth    quarterly growth of base income, so rents and incomes
;;                    can move together instead of stress saturating
;;   displaced-share-by-income t   who is protected, by initial income tercile

;; Version 2.2 adds the theory-development ladder of Week 8 (pattern-oriented
;; modelling): search-rule = "random" (null theory: apply to any visible
;; vacancy), "cheapest" (minimal intelligence: the lowest rent burden), or
;; "utility" (the softmax rule). The pattern test decides which is kept.

;; Version 2.3 (Week 7 networks, Week 8a POM): the ring is a circular lattice
;; (N = 20, degree 2, clustering 0, characteristic path length 5.26, diameter
;; 10). n-shortcuts adds random edges between non-adjacent neighbourhoods,
;; standing for transport corridors, and rewires it toward a small world;
;; distances are shortest paths on that graph. access-lost-displaced supports
;; pattern P4 (forced movers land in less accessible neighbourhoods). At the
;; defaults P4 does not emerge: unhoused households can apply anywhere and the
;; high tier sheds the most vacancies. landlord-screening? (off by default) is
;; the candidate process, POM step 4: where market applicants exceed vacancies,
;; applicants without a displacement record are matched first (Desmond and
;; Shollenberger 2015; Parkinson, James and Liu 2018). Screening alone makes
;; P4 worse, because the high tier sheds the most vacancies and nothing else
;; competes for them. non-target-competition? (off by default) is the second candidate:
;; each quarter a share non-target-frac (by tier) of market vacancies is taken by
;; higher-income non-target renters before target households are matched
;; (Reynolds, Parkinson, De Vries and Hulse 2024). Third candidate:
;; max-rent-to-income (1 = off): a new tenancy is granted only where rent is at
;; most this share of the applicant's income, the affordability screen that
;; agents apply to applications (Parkinson, James and Liu 2018).
;; Version 2.4 (Stage B pilot findings): two processes the patterns showed to
;; be missing. bg-target-move-prob: housed, unstressed tenants move for reasons
;; unrelated to stress with this quarterly probability, so the forced share of
;; moves (P2) has a realistic denominator. non-target-competition? now occupies: the
;; vacancies higher-income renters take stay occupied (non-target-occupied) until they
;; leave at termination-hazard-base, so the high tier stays full and rents there keep
;; rising (P3), as in Reynolds et al. 2024.
;;
;; Stage C (17 September 2026): interface defaults are the calibrated set
;; found by pilot-v1 to v4 (analysis/calibrate.py): income U(0.6, 1.0),
;; income-growth 0.01, bg-target-move-prob 0.15, termination-hazard-base 0.006, non-target-frac
;; 0.30/0.15/0, max-rent-to-income 0.5, non-target-competition? on, alpha 0.03.
;; Every experiment pins these unless it sweeps them.
;;
;; Every procedure is tagged with the ODD element it implements.
;; Households are the only agents. Neighbourhoods are the environment
;; (the row of patches with pycor = neighbourhood-row). Other patches are decoration.
;; =====================================================================

globals [
  neighbourhood-row               ; y coordinate of the neighbourhood row
  all-neighbourhoods                  ; agentset of the 20 neighbourhood patches
  number-of-neighbourhood                 ; 20
  total-new-units      ; affordable units added over the supply window
  units-delivered      ; running total delivered so far
  moves-forced         ; tenancy terminations (forced moves) so far
  moves-voluntary      ; successful moves by housed households so far
  cum-displaced        ; entries into the displaced pool so far (events: a household displaced twice counts twice)
  ;; mean-field (equation-based) state, one entry per neighbourhood id
  mf-H mf-U mf-A mf-D mf-cumD
  mf-B                 ; mean-field: market dwellings held by background renters, per neighbourhood
  mf-init-access       ; mean accessibility at t = 0 (mean-field)
  inc-scale            ; (1 + income-growth) ^ ticks, used by the mean-field stress fraction
  income-cuts          ; tercile cut points of initial base income
  dist-matrix          ; shortest-path distance between neighbourhoods (list of lists)
  shortcut-list        ; list of [i j] shortcut edges added at setup
  
  priority-rule
  
  n-households
  run-length
  
  mean-field?
  stock-high
  stock-mid
  stock-low
  rent-high
  rent-mid
  rent-low
  income-min
  income-max
  
  p-income-shock
  income-shock-size
  shock-duration
  
  alpha
  income-growth
  bg-target-move-prob
  non-target-competition?
  
  
  search-prob
  n-search-towns
  moving-cost
  weight-rent
  weight-access
  choice-noise
  weight-queue
  
  n-shortcuts
  max-rent-to-income
  
  cost-high
  cost-mid
  cost-low
  
  
  non-target-frac-high ; 
  non-target-frac-mid  ; 
  non-target-frac-low  ; 
  
  stress-threshold     ;
  landlord-screening?  ; 
  
  secure-tenure?       ; 
  
  income-penalty       ; 
  
  affordable-rent-ratio ; 
  rent-discount?       ; 
  income-rent-share    ;
  
  search-rule          ;
  
  
]

patches-own [
  neighbourhood-id     ; 0..19, only meaningful on the neighbourhood row
  tier                 ; 0 low, 1 medium, 2 high employment accessibility
  access               ; accessibility score 0.3 / 0.6 / 1.0
  market-stock         ; market dwellings open to target households
  market-occupied
  non-target-occupied  ; market dwellings held by higher-income non-target renters (non-target-competition?)
  affordable-capacity  ; affordable dwellings (start at 0, added by policy)
  affordable-occupied
  non-target-demand    ; background demand from non-target renters
  cost-index           ; cost of one new dwelling relative to the medium tier
  init-rent            ; rent at t = 0 (share of reference quarterly income)
  market-rent          ; current market rent
  pressure             ; (D - S) / S last computed
  applicants-market    ; applications received this tick
  applicants-affordable
  last-app-market      ; applications received last tick (queue signal)
  last-applications-affordable
]

turtles-own [
  base-income          ; income without shocks (share of reference income)
  init-income          ; base income at t = 0, for the by-income reporters
  income               ; current income
  shock-table          ; pre-drawn booleans, one per quarter
  termination-table    ; pre-drawn uniforms, one per quarter
  shock-leftover       ; quarters of shock remaining
  tenure               ; "market" "affordable" "unhoused"
  dwelling             ; neighbourhood patch of current dwelling, or last one if unhoused
  init-access          ; accessibility of the neighbourhood at t = 0
  rent-paid            ; rent this quarter
  stressed?
  stress-quarters      ; consecutive quarters in stress
  unhoused-quarters    ; consecutive quarters without a dwelling
  displaced?           ; currently in the displaced pool
  ever-displaced?
  searching?
  bg-target-mover?     ; searching this quarter for reasons unrelated to stress
  applied-to           ; patch applied to this tick, or nobody
  applied-type         ; "market" or "affordable"
]

;; ---------------------------------------------------------------------
;; ODD: Initialisation
;; ---------------------------------------------------------------------
to setup
  clear-all
  
  set number-of-neighbourhood 20
  set neighbourhood-row 3
  
  set run-length 40
  set priority-rule "lottery" ; "lottery", "longest-stressed", "incumbent-first"
  set mean-field? false
  set affordable-rent-ratio 0.75
  
  set n-households 1000
  set income-min 0.6
  set income-max 1
  set p-income-shock 0.05
  set income-shock-size 0.2
  set shock-duration 4
  set income-penalty 0.15
  set stress-threshold 0.3
  set income-growth 0.01
  set bg-target-move-prob 0.15
  
  set search-prob 0.25
  set n-search-towns 4
  set moving-cost 0.3
  set weight-rent 5
  set weight-access 1
  set choice-noise 0.3
  set weight-queue 1
  set search-rule "utility" ; "utility", "cheapest", "random"
  
  set n-shortcuts 0
  set landlord-screening? false
  set non-target-competition? true
  set max-rent-to-income 0.5
  
  set stock-high round (n-households * 0.04)
  set stock-mid round (n-households * 0.055)
  set stock-low round (n-households * 0.06)
  
  set rent-high 0.38
  set rent-mid 0.31
  set rent-low 0.25
  set alpha 0.03
  
  set cost-high 1.6
  set cost-mid 1
  set cost-low 0.6
  
  set non-target-frac-high 0.3
  set non-target-frac-mid  0.15
  set non-target-frac-low  0
 
  set secure-tenure? true
  set rent-discount? true
  set income-rent-share 0.25
  
  random-seed seed
  set number-of-neighbourhood 20
  set neighbourhood-row 3
  setup-neighbourhoods
  setup-network
  setup-households
  draw-shock-tables       ; strategy-independent draws come first so that
                          ; paired runs (same seed) share the same shocks
  ;; govt-homes is a share of households; under fixed-budget? it is a budget in
  ;; medium-tier dwelling equivalents, and dearer tiers deliver fewer units
  set total-new-units round (govt-homes / 100 * n-households)
  set units-delivered 0
  set inc-scale 1
  ;; with-local-randomness: reading an agentset consumes random draws, and
  ;; these must not shift the paired-run random stream
  with-local-randomness [
    let incs sort [init-income] of turtles
    set income-cuts (list (item (floor (n-households / 3)) incs) (item (floor (2 * n-households / 3)) incs))
  ]
  set moves-forced 0
  set moves-voluntary 0
  set cum-displaced 0
  setup-meanfield
  update-stress
  update-visuals
  reset-ticks
end

;; ODD: Entities, state variables and scales (environment)
to setup-neighbourhoods
  ask patches [ set pcolor black + 2 set neighbourhood-id -1 set tier -1 ]
  set all-neighbourhoods patches with [pycor = neighbourhood-row]
  ask all-neighbourhoods [
    set neighbourhood-id pxcor
    ;; ring layout: low tier at both ends (they touch across the wrap),
    ;; medium either side, high in the middle. Six high, eight medium, six low.
    ifelse member? pxcor [7 8 9 10 11 12] [
      set tier 2 set access 1.0 set market-stock stock-high set init-rent rent-high set cost-index cost-high
      set non-target-demand non-target-frac-high * stock-high
    ] [
      ifelse member? pxcor [3 4 5 6 13 14 15 16] [
        set tier 1 set access 0.6 set market-stock stock-mid set init-rent rent-mid set cost-index cost-mid
        set non-target-demand non-target-frac-mid * stock-mid
      ] [
        set tier 0 set access 0.3 set market-stock stock-low set init-rent rent-low set cost-index cost-low
        set non-target-demand non-target-frac-low * stock-low
      ]
    ]
    set market-rent init-rent
    set market-occupied 0
    set non-target-occupied 0
    set affordable-capacity 0
    set affordable-occupied 0
    set pressure 0
    set applicants-market 0
    set applicants-affordable 0
    set last-app-market 0
    set last-applications-affordable 0
  ]
end

;; ODD: Entities, state variables and scales (environment topology).
;; Ring edges i to i+1 (mod 20) plus n-shortcuts random extra edges; the
;; distance matrix holds shortest paths by breadth-first search. With zero
;; shortcuts distances equal the ring distance used in earlier versions.
to setup-network
  set shortcut-list []
  let tries 0
  while [length shortcut-list < n-shortcuts and tries < 1000] [
    set tries tries + 1
    let ia random number-of-neighbourhood
    let ib random number-of-neighbourhood
    let ring-d min (list (abs (ia - ib)) (number-of-neighbourhood - abs (ia - ib)))
    let edge (list (min (list ia ib)) (max (list ia ib)))
    if ring-d > 1 and not member? edge shortcut-list [ set shortcut-list lput edge shortcut-list ]
  ]
  set dist-matrix n-values number-of-neighbourhood [ src -> bfs-distances src ]
end

to-report neighbours-of [i]
  let ns (list ((i + 1) mod number-of-neighbourhood) ((i - 1 + number-of-neighbourhood) mod number-of-neighbourhood))
  foreach shortcut-list [ edge ->
    if item 0 edge = i [ set ns lput (item 1 edge) ns ]
    if item 1 edge = i [ set ns lput (item 0 edge) ns ]
  ]
  report remove-duplicates ns
end

to-report bfs-distances [source]
  let d n-values number-of-neighbourhood [ -> -1 ]
  set d replace-item source d 0
  let frontier (list source)
  while [not empty? frontier] [
    let nxt []
    foreach frontier [ u ->
      foreach neighbours-of u [ v ->
        if item v d = -1 [
          set d replace-item v d ((item u d) + 1)
          set nxt lput v nxt
        ]
      ]
    ]
    set frontier nxt
  ]
  report d
end

;; network properties, for the report (Week 7): characteristic path length,
;; mean degree, clustering coefficient (0 on a plain ring)
to-report path-length
  let tot 0
  foreach range number-of-neighbourhood [ i -> foreach range number-of-neighbourhood [ j -> if i != j [ set tot tot + item j (item i dist-matrix) ] ] ]
  report tot / (number-of-neighbourhood * (number-of-neighbourhood - 1))
end
to-report mean-degree report (2 * (number-of-neighbourhood + length shortcut-list)) / number-of-neighbourhood end
to-report clustering-coefficient
  let cs []
  foreach range number-of-neighbourhood [ i ->
    let ns neighbours-of i
    let k length ns
    ifelse k < 2 [ set cs lput 0 cs ] [
      let n-links 0
      foreach ns [ a -> foreach ns [ b -> if a < b and member? b (neighbours-of a) [ set n-links n-links + 1 ] ] ]
      set cs lput (2 * n-links / (k * (k - 1))) cs
    ]
  ]
  report mean cs
end

;; ODD: Entities, state variables and scales (agents) and Initialisation
to setup-households
  if n-households > sum [market-stock] of all-neighbourhoods [
    user-message "n-households exceeds total market stock; raise stock sliders."
    stop
  ]
  create-turtles n-households [
    set shape "dot"
    set size 0.5
    set base-income income-min + random-float (income-max - income-min)
    set init-income base-income
    set income base-income
    set shock-leftover 0
    ;; place with probability proportional to remaining vacancies
    let target weighted-pick all-neighbourhoods [ p -> [market-stock - market-occupied - non-target-occupied] of p ]
    set dwelling target
    ask target [ set market-occupied market-occupied + 1 ]
    set tenure "market"
    set init-access [access] of target
    set stressed? false
    set stress-quarters 0
    set unhoused-quarters 0
    set displaced? false
    set ever-displaced? false
    set searching? false
    set bg-target-mover? false
    set applied-to nobody
    set applied-type "market"
    place-in-column
  ]
end

;; ODD: Stochasticity. Shock and termination draws are made once, before
;; any strategy-dependent randomness, so runs sharing a seed share them.
to draw-shock-tables
  ask turtles [
    set shock-table n-values run-length [ -> random-float 1 < p-income-shock ]
    set termination-table n-values run-length [ -> random-float 1 ]
  ]
end

;; ---------------------------------------------------------------------
;; ODD: Process overview and scheduling (one tick = one quarter)
;; ---------------------------------------------------------------------
to go
  if ticks >= run-length [ stop ]
  ifelse mean-field? [
    go-meanfield
  ] [
    step-incomes            ; 1 incomes update
    step-terminations       ; 2 tenancies end
    step-rents              ; 3 rents update
    update-stress           ; 4 stress classified
    step-search-and-match   ; 5 search and matching
    step-supply             ; 6 supply enters
    update-visuals          ; 7 outputs recorded (plots read reporters)
    print (word "Quarter: " ticks " | Displacements Share per Households: " (displaced-share * 100))
  ]
  tick
end

;; ODD: Submodel 1, income process
to step-incomes
  set inc-scale inc-scale * (1 + income-growth)
  ask turtles [
    set base-income base-income * (1 + income-growth)
    if (item ticks shock-table) and shock-leftover = 0 [ set shock-leftover shock-duration ]
    ifelse shock-leftover > 0 [
      set income base-income * (1 - income-shock-size)
      set shock-leftover shock-leftover - 1
    ] [
      set income base-income
    ]
  ]
end

;; ODD: Submodel 2, tenancy termination hazard rising with local rent pressure
to step-terminations
  ;; background tenants (non-target-competition?) leave at the base hazard
  if non-target-competition? [
    ask all-neighbourhoods [
      let leaving 0
      repeat non-target-occupied [ if random-float 1 < termination-hazard-base [ set leaving leaving + 1 ] ]
      set non-target-occupied non-target-occupied - leaving
    ]
  ]
  ;; affordable tenancies are exempt while secure-tenure? is on
  ask turtles with [tenure = "market" or (tenure = "affordable" and not secure-tenure?)] [
    let h termination-hazard-base * (1 + termination-hazard-coef * max (list 0 [pressure] of dwelling))
    if (item ticks termination-table) < h [
      ifelse tenure = "affordable"
        [ ask dwelling [ set affordable-occupied affordable-occupied - 1 ] ]
        [ ask dwelling [ set market-occupied market-occupied - 1 ] ]
      set tenure "unhoused"
      set unhoused-quarters 0
      set moves-forced moves-forced + 1
    ]
  ]
end

;; ODD: Submodel 3, rent update  rent <- rent * (1 + alpha * (D - S) / S)
;; D = occupied + applicants (previous tick, only if rent-feedback?) + background
;; S = market stock + affordable capacity
to step-rents
  ask all-neighbourhoods [
    let apps ifelse-value rent-feedback? [applicants-market + applicants-affordable] [0]
    let Demand market-occupied + non-target-occupied + affordable-occupied + apps + non-target-demand
    let Supply market-stock + affordable-capacity
    set pressure clamp ((Demand - Supply) / Supply) (- 0.5) 0.5
    set market-rent clamp (market-rent * (1 + alpha * pressure)) (0.5 * init-rent) (3 * init-rent)
  ]
end

;; ODD: Submodel 4, stress classification (30/40 rule threshold)
to update-stress
  ask turtles [
    ifelse tenure = "unhoused" [
      set rent-paid 0
      set stressed? true
    ] [
      set rent-paid ifelse-value tenure = "affordable"
        [affordable-rent-of dwelling] [[market-rent] of dwelling]
      set stressed? (rent-paid / income) > stress-threshold
    ]
    ifelse stressed? [ set stress-quarters stress-quarters + 1 ] [ set stress-quarters 0 ]
  ]
end

;; ODD: Submodel 5, search and matching. This is where households interact:
;; applicants for the same unit compete, and one household's success moves
;; another one quarter closer to displacement.
to step-search-and-match
  ask all-neighbourhoods [
    set last-app-market applicants-market
    set last-applications-affordable applicants-affordable
    set applicants-market 0
    set applicants-affordable 0
  ]
  ask turtles [ set applied-to nobody set searching? false set bg-target-mover? false ]
  ask turtles with [tenure = "unhoused"] [ set searching? true ]
  ask turtles with [tenure = "market" and stressed?] [
    if random-float 1 < search-prob [ set searching? true ]
  ]
  ;; moves unrelated to stress (life events): any housed market tenant, so
  ;; the forced share of moves has a realistic denominator even when most
  ;; tenants are stressed. Guarded so that a zero probability draws no random
  ;; numbers and earlier results reproduce exactly.
  if bg-target-move-prob > 0 [
    ask turtles with [tenure = "market"] [
      if random-float 1 < bg-target-move-prob [ set searching? true set bg-target-mover? true ]
    ]
  ]
  ask turtles with [searching?] [ choose-application ]
  ask all-neighbourhoods [
    match-type "affordable"
    match-type "market"
  ]
  ;; households still without a dwelling
  ask turtles with [tenure = "unhoused"] [
    set unhoused-quarters unhoused-quarters + 1
    if (not displaced?) and unhoused-quarters >= s-search-period [
      set displaced? true
      set ever-displaced? true
      set cum-displaced cum-displaced + 1
      set base-income base-income * (1 - income-penalty)
      ;; assumption-reversal run: displaced households leave the region
      if displaced-leave? [ die ]
    ]
  ]
end

;; Household chooses one (neighbourhood, unit type) to apply to.
;; Choice set: own neighbourhood plus (k - 1) sampled others; with
;; induced-demand? on, every neighbourhood holding an affordable vacancy is
;; also visible. Affordable vacancies elsewhere are invisible when off.
to choose-application
  let me self
  let myhome dwelling
  let sampled n-of (min (list (n-search-towns - 1) (number-of-neighbourhood - 1))) (all-neighbourhoods with [self != myhome])
  let candidate (patch-set myhome sampled)
  if induced-demand? [ set candidate (patch-set candidate all-neighbourhoods with [affordable-capacity - affordable-occupied > 0]) ]
  let options []
  foreach sort candidate [ p ->
    let affordable-vacancies [affordable-capacity - affordable-occupied] of p
    let market-vacancies [market-stock - market-occupied - non-target-occupied] of p
    let aff-visible (affordable-vacancies > 0) and (induced-demand? or p = myhome)
    if aff-visible [ set options lput (list p "affordable" (utility-of p "affordable")) options ]
    if market-vacancies > 0 and not (tenure = "market" and p = myhome) [
      set options lput (list p "market" (utility-of p "market")) options
    ]
  ]
  ;; affordability screen on new tenancies: rent at most max-rent-to-income
  ;; of the applicant's income (1 = no screen)
  if max-rent-to-income < 1 [
    set options filter [ house -> (rent-of (item 0 house) (item 1 house)) <= max-rent-to-income * income ] options
  ]
  ;; a stressed housed household only moves to something cheaper than it pays
  ;; now; a household moving for other reasons chooses by utility alone
  if tenure = "market" and stressed? and not bg-target-mover? [
    set options filter [ house -> rent-of (item 0 house) (item 1 house) < 0.98 * rent-paid ] options
  ]
  if empty? options [ stop ]
  let weights choice-weights options
  let chosen item (weighted-index weights) options
  set applied-to item 0 chosen
  set applied-type item 1 chosen
  ask applied-to [
    ifelse [applied-type] of me = "affordable"
      [ set applicants-affordable applicants-affordable + 1 ]
      [ set applicants-market applicants-market + 1 ]
  ]
end

;; ODD: Adaptation. Three alternative theories of how a household chooses among
;; its options (pattern-oriented theory development, Grimm and Railsback 2005):
;;   random   null theory, every visible vacancy equally likely
;;   cheapest minimal intelligence, the option with the lowest rent burden
;;   utility  softmax on U (rent burden, accessibility, moving cost, queue)
;; options are lists [patch type utility]; the rent burden is recomputed here.
to-report choice-weights [options]
  if search-rule = "random" [ report map [ house -> 1 ] options ]
  if search-rule = "cheapest" [
    let burdens map [ house -> (rent-of (item 0 house) (item 1 house)) ] options
    let best min burdens
    report map [ b -> ifelse-value b = best [1] [0] ] burdens
  ]
  let maxu max map [ house -> item 2 house ] options
  report map [ house -> exp ((item 2 house - maxu) / choice-noise) ] options
end

to-report rent-of [neighbourhood type-neighbourhood]
  report ifelse-value type-neighbourhood = "affordable" [affordable-rent-of neighbourhood] [[market-rent] of neighbourhood]
end

;; effective discount: affordable-rent-ratio with the discount on, 1 with it off
to-report lambda-eff
  report ifelse-value rent-discount? [affordable-rent-ratio] [1]
end

;; rent of an affordable unit in neighbourhood p for the calling household
;; (turtle context: the income-share rule depends on the household's income)
to-report affordable-rent-of [house]
  if affordable-rent-rule = "income-share" [ report income-rent-share * income ]
  report lambda-eff * [market-rent] of house
end

;; mean-field counterpart: fraction of affordable tenants in p who are stressed
to-report mf-aff-stressed-fraction [p]
  if affordable-rent-rule = "income-share" [ report ifelse-value income-rent-share > stress-threshold [1] [0] ]
  report stressed-fraction (lambda-eff * [market-rent] of p)
end

;; Utility of an option: rent burden, accessibility, moving cost with ring
;; distance, and a queue penalty from last quarter's applicants per vacancy
;; (households avoid lotteries they are unlikely to win).
to-report utility-of [neighbourhood type-neighbourhood]
  let burden (rent-of neighbourhood type-neighbourhood) / income
  let mc ifelse-value neighbourhood = dwelling [0] [moving-cost * (1 + (ring-distance dwelling neighbourhood) / 10)]
  let vacancies ifelse-value type-neighbourhood = "affordable" [[affordable-capacity - affordable-occupied] of neighbourhood] [[market-stock - market-occupied - non-target-occupied] of neighbourhood]
  let lastapp ifelse-value type-neighbourhood = "affordable" [[last-applications-affordable] of neighbourhood] [[last-app-market] of neighbourhood]
  let queue ln (1 + lastapp / (max (list 1 vacancies)))
  report (- weight-rent * burden) + (weight-access * [access] of neighbourhood) - mc - (weight-queue * queue)
end

;; shortest-path distance on the neighbourhood network (ring plus shortcuts)
to-report ring-distance [a b]
  report item ([neighbourhood-id] of b) (item ([neighbourhood-id] of a) dist-matrix)
end

;; Allocate vacancies of one type in this neighbourhood among applicants.
to match-type [ty]
  let here self
  let apps turtles with [applied-to = here and applied-type = ty]
  let vac ifelse-value ty = "affordable" [affordable-capacity - affordable-occupied] [market-stock - market-occupied - non-target-occupied]
  ;; background competition: higher-income renters take a share of this
  ;; quarter's market vacancies first (binomial draw, tier-specific share) and
  ;; hold them until they leave at the base hazard
  if non-target-competition? and ty = "market" and vac > 0 [
    let share non-target-demand / market-stock
    let taken 0
    repeat vac [ if random-float 1 < share [ set taken taken + 1 ] ]
    set non-target-occupied non-target-occupied + taken
    set vac vac - taken
  ]
  if (not any? apps) or vac <= 0 [ stop ]
  let winners apps
  ;; landlord screening applies to market units only: applicants with a
  ;; displacement record are considered after those without one
  if landlord-screening? and ty = "market" and count apps > vac [
    let clean apps with [not ever-displaced?]
    ifelse count clean >= vac
      [ set apps clean ]
      [ set apps (turtle-set clean (n-of (vac - count clean) (apps with [ever-displaced?]))) ]
  ]
  ;; the priority rule is the policy's allocation rule for affordable units;
  ;; private-market vacancies are always a lottery among the (screened) applicants
  if count apps > vac and ty = "market" [ set winners n-of vac apps ]
  if count apps > vac and ty = "affordable" [
    if priority-rule = "lottery" [ set winners n-of vac apps ]
    if priority-rule = "longest-stressed" [
      set winners max-n-of vac apps [ stress-quarters + random-float 0.001 ]
    ]
    if priority-rule = "incumbent-first" [
      let incumbents apps with [dwelling = here]
      ifelse count incumbents >= vac [
        set winners n-of vac incumbents
      ] [
        set winners (turtle-set incumbents (n-of (vac - count incumbents) (apps with [dwelling != here])))
      ]
    ]
  ]
  ask winners [ move-in here ty ]
end

to move-in [p ty]
  if tenure = "market" [
    ask dwelling [ set market-occupied market-occupied - 1 ]
    set moves-voluntary moves-voluntary + 1
  ]
  set dwelling p
  set tenure ty
  ifelse ty = "affordable"
    [ ask p [ set affordable-occupied affordable-occupied + 1 ] ]
    [ ask p [ set market-occupied market-occupied + 1 ] ]
  set displaced? false
  set unhoused-quarters 0
  place-in-column
end

;; ODD: Submodel 6, supply entry. Tranche t of the window delivers
;; round(cum_t) - round(cum_(t-1)) units, shared by strategy, with
;; largest-remainder rounding across neighbourhoods.
to step-supply
  if strategy = "none" or ticks >= govt-homes-build-time or total-new-units = 0 [ stop ]
  let per total-new-units / govt-homes-build-time
  let build_this_quarter (round (per * (ticks + 1))) - (round (per * ticks))
  if build_this_quarter <= 0 [ stop ]
  let shares []
  foreach sort all-neighbourhoods [ p -> set shares lput (share-of p) shares ]
  let whole-affordable-units-allocated allocate-units build_this_quarter shares
  foreach sort all-neighbourhoods [ p ->
    ask p [ set affordable-capacity affordable-capacity + item neighbourhood-id whole-affordable-units-allocated ]
  ]
  set units-delivered units-delivered + sum whole-affordable-units-allocated
end

;; Turn this quarter's tranche r-t (a budget in medium-tier dwelling
;; equivalents when fixed-budget? is on, otherwise a number of dwellings) into
;; whole units per neighbourhood, in proportion to shares, with largest-
;; remainder rounding. Under a fixed budget a neighbourhood with cost-index c
;; gets amount / c dwellings, so dearer tiers deliver fewer units.
to-report allocate-units [build_this_quarter shares]
  let tot sum shares
  if tot <= 0 [ set shares n-values number-of-neighbourhood [ -> 1 ] set tot number-of-neighbourhood ]
  let plist sort all-neighbourhoods
  let amounts map [ s -> build_this_quarter * s / tot ] shares
  if fixed-budget? [
    set amounts (map [ [a p] -> a / [cost-index] of p ] amounts plist)
  ]
  let whole-affordable-units-allocated map [ a -> floor a ] amounts
  let remaining map [ a -> a - floor a ] amounts
  let leftover (round sum amounts) - sum whole-affordable-units-allocated
  ;; ties in the remainder go to the neighbourhood with the fewest units so far, then the lower id,
  ;; so equal shares spread evenly instead of always favouring the lowest ids
  let caps map [ p -> [affordable-capacity] of p ] plist
  let idx sort-by [ [i j] -> (item i remaining > item j remaining) or (item i remaining = item j remaining and item i caps < item j caps) or (item i remaining = item j remaining and item i caps = item j caps and i < j) ] (range number-of-neighbourhood)
  foreach (sublist idx 0 leftover) [ i -> set whole-affordable-units-allocated replace-item i whole-affordable-units-allocated(item i whole-affordable-units-allocated + 1) ]
  report whole-affordable-units-allocated
end

to-report share-of [neighbourhood]
  if strategy = "concentrated" [ report ifelse-value [tier] of neighbourhood = 2 [1] [0] ]
  if strategy = "dispersed" [ report 1 ]
  if strategy = "demand-proportional" [
    ;; renter demand now: stressed housed households plus unhoused ones attached here
    report count turtles with [dwelling = neighbourhood and (stressed? or tenure = "unhoused")]
  ]
  ;; if strategy = "outer" [ report ifelse-value [tier] of neighbourhood = 0 [1] [0] ]
  report 0
end

;; ---------------------------------------------------------------------
;; ODD: Observation. Reporters used by plots, monitors and BehaviorSpace.
;; Each reporter has an agent branch and a mean-field branch.
;; ---------------------------------------------------------------------
to-report n-hh report count turtles end
to-report displaced-share             ; key metric: displacements per household (events, not unique households)
  report cum-displaced / n-households
end
to-report currently-displaced-share
  report ifelse-value mean-field? [(sum mf-D) / n-households] [(count turtles with [displaced?]) / n-hh]
end
to-report unhoused-share
  report ifelse-value mean-field? [(sum mf-U) / n-households] [(count turtles with [tenure = "unhoused"]) / n-hh]
end
to-report stress-prevalence
  ifelse mean-field? [
    let plist sort all-neighbourhoods
    let stcount 0
    foreach range number-of-neighbourhood [ i ->
      let p item i plist
      set stcount stcount + (stressed-fraction [market-rent] of p) * item i mf-H
                + (mf-aff-stressed-fraction p) * item i mf-A
    ]
    report (stcount + sum mf-U + sum mf-D) / n-households
  ] [
    report (count turtles with [stressed?]) / n-hh
  ]
end
to-report mean-stress-duration        ; not defined for the mean-field version (reports 0)
  if mean-field? [ report 0 ]
  let s turtles with [stress-quarters > 0]
  report ifelse-value any? s [mean [stress-quarters] of s] [0]
end
to-report access-lost
  ifelse mean-field? [
    let plist sort all-neighbourhoods
    let cur 0
    foreach range number-of-neighbourhood [ i -> set cur cur + ((item i mf-H) + (item i mf-A)) * [access] of item i plist ]
    report mf-init-access - cur / n-households
  ] [
    report mean [ init-access - (ifelse-value tenure = "unhoused" [0] [[access] of dwelling]) ] of turtles
  ]
end
to-report rent-increase-tier [t]
  report mean [market-rent / init-rent] of all-neighbourhoods with [tier = t]
end
to-report rent-increase-high report rent-increase-tier 2 end
to-report rent-increase-mid  report rent-increase-tier 1 end
to-report rent-increase-low  report rent-increase-tier 0 end
to-report affordable-occupancy
  let cap sum [affordable-capacity] of all-neighbourhoods
  if cap = 0 [ report 0 ]
  report ifelse-value mean-field? [(sum mf-A) / cap] [(sum [affordable-occupied] of all-neighbourhoods) / cap]
end
to-report forced-move-share
  let tot moves-forced + moves-voluntary
  report ifelse-value tot > 0 [moves-forced / tot] [0]
end
to-report stress-share-tier [t]
  if mean-field? [
    let ps all-neighbourhoods with [tier = t]
    let stcount 0
    let hh 0
    ask ps [
      set stcount stcount + (stressed-fraction market-rent) * item neighbourhood-id mf-H + (mf-aff-stressed-fraction self) * item neighbourhood-id mf-A
      set hh hh + item neighbourhood-id mf-H + item neighbourhood-id mf-A
    ]
    report ifelse-value hh > 0 [stcount / hh] [0]
  ]
  let hh turtles with [tenure != "unhoused" and [tier] of dwelling = t]
  report ifelse-value any? hh [(count hh with [stressed?]) / count hh] [0]
end
;; share of households attached to neighbourhood i (housed there, or last
;; housed there if unhoused) that are stressed: one value per ring position
to-report stress-share-nb [i]
  let p one-of all-neighbourhoods with [neighbourhood-id = i]
  if mean-field? [
    let hh (item i mf-H) + (item i mf-A) + (item i mf-U) + (item i mf-D)
    if hh = 0 [ report 0 ]
    report ((stressed-fraction [market-rent] of p) * item i mf-H
            + (mf-aff-stressed-fraction p) * item i mf-A
            + item i mf-U + item i mf-D) / hh
  ]
  let hh turtles with [dwelling = p]
  report ifelse-value any? hh [(count hh with [stressed?]) / count hh] [0]
end
;; share of affordable tenants who are still stressed: the discount test
to-report affordable-stressed-share
  if mean-field? [
    let tot sum mf-A
    if tot = 0 [ report 0 ]
    report (sum map [ p -> (mf-aff-stressed-fraction p) * item ([neighbourhood-id] of p) mf-A ] sort all-neighbourhoods) / tot
  ]
  let hh turtles with [tenure = "affordable"]
  report ifelse-value any? hh [(count hh with [stressed?]) / count hh] [0]
end
;; who is protected: share ever displaced by initial-income tercile (0 lowest)
to-report displaced-share-by-income [t]
  if mean-field? [ report 0 ]
  let lo ifelse-value t = 0 [-1] [item (t - 1) income-cuts]
  let hi ifelse-value t = 2 [1e9] [item t income-cuts]
  let hh turtles with [init-income >= lo and init-income < hi]
  report ifelse-value any? hh [(count hh with [ever-displaced?]) / count hh] [0]
end
to-report units-delivered-total report units-delivered end
;; pattern P4: accessibility lost by households that were ever displaced
;; (initial accessibility minus current, 0 for the currently unhoused)
to-report access-lost-displaced
  if mean-field? [ report 0 ]
  let hh turtles with [ever-displaced?]
  report ifelse-value any? hh [mean [ init-access - (ifelse-value tenure = "unhoused" [0] [[access] of dwelling]) ] of hh] [0]
end
to-report access-lost-not-displaced
  if mean-field? [ report 0 ]
  let hh turtles with [not ever-displaced?]
  report ifelse-value any? hh [mean [ init-access - (ifelse-value tenure = "unhoused" [0] [[access] of dwelling]) ] of hh] [0]
end
to-report displaced-share-by-tier [t] ; agent version only (mean-field reports 0)
  if mean-field? [ report 0 ]
  let hh turtles with [init-access = (item t [0.3 0.6 1.0])]
  report ifelse-value any? hh [(count hh with [ever-displaced?]) / count hh] [0]
end

;; ---------------------------------------------------------------------
;; Equation-based (mean-field) counterpart. Same rates, no individual
;; agents, no lottery: flows are expected values. Used to show what
;; heterogeneity and matching add. Switch mean-field? on and press setup.
;; ---------------------------------------------------------------------
to setup-meanfield
  set mf-H n-values number-of-neighbourhood [ -> 0 ]
  set mf-U n-values number-of-neighbourhood [ -> 0 ]
  set mf-A n-values number-of-neighbourhood [ -> 0 ]
  set mf-D n-values number-of-neighbourhood [ -> 0 ]
  set mf-B n-values number-of-neighbourhood [ -> 0 ]
  set mf-cumD 0
  foreach sort all-neighbourhoods [ p -> set mf-H replace-item ([neighbourhood-id] of p) mf-H ([market-occupied] of p) ]
  set mf-init-access (sum [market-occupied * access] of all-neighbourhoods) / n-households
  ask turtles [ set hidden? mean-field? ]
end

;; fraction of a uniform(income-min, income-max) population stressed at rent r
;; incomes are uniform(income-min, income-max) x inc-scale in the mean-field branch
to-report stressed-fraction [r]
  let cut r / stress-threshold
  report clamp ((cut - income-min * inc-scale) / ((income-max - income-min) * inc-scale)) 0 1
end

to go-meanfield
  let ids range number-of-neighbourhood
  let plist sort all-neighbourhoods
  set inc-scale inc-scale * (1 + income-growth)
  ;; 2 terminations
  foreach ids [ i ->
    let p item i plist
    let h termination-hazard-base * (1 + termination-hazard-coef * max (list 0 [pressure] of p))
    let T h * item i mf-H
    set mf-H replace-item i mf-H (item i mf-H - T)
    set mf-U replace-item i mf-U (item i mf-U + T)
    set moves-forced moves-forced + T
    if non-target-competition? [ set mf-B replace-item i mf-B ((item i mf-B) * (1 - termination-hazard-base)) ]
    if not secure-tenure? [
      let TA h * item i mf-A
      set mf-A replace-item i mf-A (item i mf-A - TA)
      set mf-U replace-item i mf-U (item i mf-U + TA)
      set moves-forced moves-forced + TA
    ]
  ]
  ;; 3 rents (applicants = last tick's searchers if rent-feedback?)
  foreach ids [ i ->
    let p item i plist
    let apps ifelse-value rent-feedback? [[applicants-market + applicants-affordable] of p] [0]
    let D (item i mf-H) + (item i mf-B) + (item i mf-A) + apps + [non-target-demand] of p
    let S [market-stock + affordable-capacity] of p
    ask p [
      set pressure clamp ((D - S) / S) (- 0.5) 0.5
      set market-rent clamp (market-rent * (1 + alpha * pressure)) (0.5 * init-rent) (3 * init-rent)
    ]
  ]
  ;; 5 search. Two groups per origin: unhoused (any option, including the
  ;; displaced pool, which keeps searching) and voluntary movers (only
  ;; options cheaper than their current rent, as in the agent rule).
  ;; Expected flows use the softmax utility at the mean income.
  let inflow-m n-values number-of-neighbourhood [ -> 0 ]
  let inflow-a n-values number-of-neighbourhood [ -> 0 ]
  let unhoused-total (sum mf-U) + (sum mf-D)
  let voluntary-total 0
  let mean-inc inc-scale * (income-min + income-max) / 2
  foreach ids [ i ->
    let p item i plist
    let voluntary search-prob * (stressed-fraction [market-rent] of p) * item i mf-H
    let bgm bg-target-move-prob * item i mf-H
    set voluntary-total voluntary-total + voluntary + bgm
    let unh (item i mf-U) + (item i mf-D)
    foreach (list (list unh false) (list voluntary true) (list bgm false)) [ grp ->
      let amount item 0 grp
      let cheaper-only item 1 grp
      if amount > 0 [
        let opts mf-options i cheaper-only mean-inc
        if not empty? opts [
          let w mf-choice-weights opts
          let tw sum w
          (foreach opts w [ [o wi] ->
            let j item 0 o
            let amt amount * wi / tw
            ifelse item 1 o = "affordable"
              [ set inflow-a replace-item j inflow-a (item j inflow-a + amt) ]
              [ set inflow-m replace-item j inflow-m (item j inflow-m + amt) ]
          ])
        ]
      ]
    ]
  ]
  ;; placements capped by vacancies
  let h-before mf-H    ; market tenants before placements, used to remove movers from their origins
  let placed-total 0
  foreach ids [ j ->
    let q item j plist
    let cap-affordable max (list 0 ([affordable-capacity] of q - item j mf-A))
    let cap-market max (list 0 ([market-stock] of q - item j mf-H - item j mf-B))
    if non-target-competition? [
      let taken cap-market * ([non-target-demand] of q / [market-stock] of q)
      set mf-B replace-item j mf-B (item j mf-B + taken)
      set cap-market cap-market - taken
    ]
    let placed-a min (list cap-affordable item j inflow-a)
    let placed-m min (list cap-market item j inflow-m)
    ask q [
      set last-applications-affordable applicants-affordable
      set last-app-market applicants-market
      set applicants-affordable item j inflow-a
      set applicants-market item j inflow-m
    ]
    set mf-A replace-item j mf-A (item j mf-A + placed-a)
    set mf-H replace-item j mf-H (item j mf-H + placed-m)
    set placed-total placed-total + placed-a + placed-m
  ]
  ;; who got placed: pro rata between the unhoused pool and voluntary movers
  let searchers unhoused-total + voluntary-total
  if placed-total > 0 and searchers > 0 [
    let placed-unhoused placed-total * unhoused-total / searchers
    let placed-voluntary placed-total - placed-unhoused
    if unhoused-total > 0 [
      set mf-U map [ u -> u * (1 - placed-unhoused / unhoused-total) ] mf-U
      set mf-D map [ d -> d * (1 - placed-unhoused / unhoused-total) ] mf-D
    ]
    if voluntary-total > 0 [
      foreach ids [ i ->
        let p item i plist
        let sf stressed-fraction [market-rent] of p
        let voluntary (search-prob * sf + bg-target-move-prob) * item i h-before
        set mf-H replace-item i mf-H (item i mf-H - placed-voluntary * voluntary / voluntary-total)
      ]
    ]
    set moves-voluntary moves-voluntary + placed-voluntary
  ]
  ;; displacement: unhoused enter the displaced pool at rate 1 / s
  foreach ids [ i ->
    let flow (item i mf-U) / s-search-period
    set mf-U replace-item i mf-U (item i mf-U - flow)
    set mf-D replace-item i mf-D (item i mf-D + flow)
    set mf-cumD mf-cumD + flow
  ]
  set cum-displaced mf-cumD
  ;; 6 supply, identical rule (demand-proportional uses expected stressed counts)
  step-supply-meanfield
  update-visuals
end

to-report mf-choice-weights [opts]
  if search-rule = "random" [ report map [ o -> 1 ] opts ]
  if search-rule = "cheapest" [
    ;; the utility's rent term is - weight-rent * rent / mean income, so the highest
    ;; value of that term is the cheapest option; item 3 carries it
    let best max map [ o -> item 3 o ] opts
    report map [ o -> ifelse-value (item 3 o) = best [1] [0] ] opts
  ]
  let maxu max map [ o -> item 2 o ] opts
  report map [ o -> exp ((item 2 o - maxu) / choice-noise) ] opts
end

to-report mf-options [i cheaper-only mean-inc]
  let plist sort all-neighbourhoods
  let p item i plist
  let opts []
  foreach range number-of-neighbourhood [ j ->
    let q item j plist
    let affordable-vacancies [affordable-capacity] of q - item j mf-A
    let market-vacancies [market-stock] of q - item j mf-H - item j mf-B
    let dist item j (item i dist-matrix)
    let mc ifelse-value i = j [0] [moving-cost * (1 + dist / 10)]
    let ra ifelse-value affordable-rent-rule = "income-share" [income-rent-share * mean-inc] [lambda-eff * [market-rent] of q]
    let rm [market-rent] of q
    let ok-a (not cheaper-only) or (ra < 0.98 * [market-rent] of p)
    let ok-m (not cheaper-only) or (rm < 0.98 * [market-rent] of p)
    if affordable-vacancies > 0 and (induced-demand? or i = j) and ok-a [
      let qa weight-queue * ln (1 + [last-applications-affordable] of q / (max (list 1 affordable-vacancies)))
      set opts lput (list j "affordable" ((- weight-rent * ra / mean-inc) + weight-access * [access] of q - mc - qa) (- ra)) opts
    ]
    if market-vacancies > 0 and ok-m and (not (cheaper-only and i = j)) [
      let qm weight-queue * ln (1 + [last-app-market] of q / (max (list 1 market-vacancies)))
      set opts lput (list j "market" ((- weight-rent * rm / mean-inc) + weight-access * [access] of q - mc - qm) (- rm)) opts
    ]
  ]
  report opts
end

to step-supply-meanfield
  if strategy = "none" or ticks >= govt-homes-build-time or total-new-units = 0 [ stop ]
  let per total-new-units / govt-homes-build-time
  let r-t (round (per * (ticks + 1))) - (round (per * ticks))
  if r-t <= 0 [ stop ]
  let plist sort all-neighbourhoods
  let shares map [ p ->
    ifelse-value strategy = "concentrated" [ifelse-value [tier] of p = 2 [1] [0]]
    [ifelse-value strategy = "dispersed" [1]
      [(stressed-fraction [market-rent] of p) * item ([neighbourhood-id] of p) mf-H + item ([neighbourhood-id] of p) mf-U]]
  ] plist
  let whole allocate-units r-t shares
  foreach plist [ p -> ask p [ set affordable-capacity affordable-capacity + item neighbourhood-id whole ] ]
  set units-delivered units-delivered + sum whole
end

;; ---------------------------------------------------------------------
;; Helpers and visuals
;; ---------------------------------------------------------------------
to-report clamp [x lo hi]
  report max (list lo (min (list hi x)))
end

;; pick one agent from agset with probability proportional to weight-task
to-report weighted-pick [agset weight-task]
  let members sort agset
  let ws map [ a -> (runresult weight-task a) ] members
  report item (weighted-index ws) members
end

to-report weighted-index [ws]
  let r random-float sum ws
  let acc 0
  let i 0
  while [i < length ws] [
    set acc acc + item i ws
    if r < acc [ report i ]
    set i i + 1
  ]
  report (length ws) - 1
end

to place-in-column
  setxy ([pxcor] of dwelling - 0.45 + random-float 0.9) (random-float (max-pycor + 0.99) - 0.5)
end

to update-visuals
  ask all-neighbourhoods [
    ;; shade by tier, brightened by rent pressure
    let base ifelse-value tier = 2 [red] [ifelse-value tier = 1 [orange] [yellow]]
    set pcolor base - 2 + 4 * (pressure + 0.5)
    set plabel (word (round (100 * market-rent / init-rent)) "%")
    set plabel-color black
  ]
  ask turtles [
    set color ifelse-value tenure = "unhoused" [white]
      [ifelse-value tenure = "affordable" [blue] [ifelse-value stressed? [red] [green]]]
  ]
end
