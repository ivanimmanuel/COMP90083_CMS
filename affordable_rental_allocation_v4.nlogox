        <metric>rent-increase-low</metric>
        <metric>path-length</metric>
        <metric>mean-degree</metric>
        <metric>clustering-coefficient</metric>
      </metrics>
      <constants>
        <enumeratedValueSet variable="seed">
          <value value="1"></value>
          <value value="2"></value>
          <value value="3"></value>
          <value value="4"></value>
          <value value="5"></value>
